rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule: Allow read and write access for all hotel management system collections
    match /{document=**} {
      allow read, write: if true;
    }

    // Specific collection rules
    match /users/{userId} {
      allow read, write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }

    match /room_types/{typeId} {
      allow read, write: if true;
    }

    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    match /guest_feedback/{feedbackId} {
      allow read, write: if true;
    }
  }
}
